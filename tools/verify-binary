#!/usr/bin/env python3
"""verify-binary — offline static analysis of a Minecraft Bedrock ``libminecraftpe.so``.

The launcher's native hooks resolve game functions through RTTI/vtable names and per-version
byte signatures. Both are version-fragile: a slot index moves between builds and a byte
pattern that matched 1.26.50 matches nothing on 1.26.60. This tool derives, *from a real
library file*, the facts a rules entry needs, and prints them with the evidence (addresses and
disassembly) so each claim can be checked by hand.

It does NOT run the game and it does NOT download anything. Point it at an extracted
``lib/arm64-v8a/libminecraftpe.so`` (arm64-v8a, 64-bit ELF only).

What it reports
---------------
1. ``LivePlayerRenderer`` RTTI/vtable: the typeinfo, the vtable address point, the slot whose
   body references the render diagnostic (``variable.player_x_rotation``), and the function's
   prologue.
2. ``ClientInstance`` slot 31 (the local-player accessor) and the ``Actor`` field offsets the
   launcher already pins (position ``+0x230``, rotation ``+0x238``), for sanity.
3. ``SerializedSkinRef`` / ``mce::Image`` seams, if the accessor-name strings survive the build.
4. ``mce::ImageUtils::loadImageFromMemory``: whether the configured byte pattern still matches
   exactly once, and a fresh candidate pattern derived from the string cross-reference + the
   enclosing prologue if it does not.
5. ``ClientNetworkHandler::AddPlayerPacket`` handler (the packet-read seam), by name.
6. A generated rules entry (JSON) for the library's version, with a SHA-256 checksum of the
   library so a rule can refuse to apply to a different build.

Anything the tool could not derive is reported as ``unverified`` - it never guesses a value.

Usage
-----
    tools/verify-binary path/to/libminecraftpe.so [--rules resources/preloader/preloader_signature_rules_source.json]
    tools/verify-binary lib.so --json                 # machine-readable summary
    tools/verify-binary lib.so --version 1.26.33.1    # override the version label

Exit code is 0 when the file parsed, 2 when it could not be read/parsed. A "not found" finding
is normal on a stripped build and is not a failure.
"""

import argparse
import hashlib
import json
import mmap
import os
import struct
import subprocess
import sys

R_AARCH64_RELATIVE = 1027
R_AARCH64_ABS64 = 257
POINTER_SIZE = 8

# The render diagnostic referenced by the LivePlayerRenderer render entry's body. Its presence in
# a vtable slot's body is how the launcher finds the slot without a per-build index.
RENDER_DIAGNOSTIC = b"variable.player_x_rotation"

try:
    import numpy as _np
except Exception:  # pragma: no cover - numpy is present in the dev environment
    _np = None


def _sign_extend(value, bits):
    if value & (1 << (bits - 1)):
        return value - (1 << bits)
    return value


def _scan_code_referencing_python(text_bytes, text_va, target_va):
    """Pure-Python ADRP(+ADD) scan: the fallback when numpy is unavailable.

    numpy is only a speed-up here; the rule is the same. Returning an empty list because a
    dependency was missing would read as "no references" and silently disable every RTTI-derived
    seam, which is exactly the kind of quiet wrong answer this tool exists to avoid. So the scan is
    implemented twice and the caller picks whichever is available.
    """
    target_page = target_va & ~0xFFF
    hits = []
    n = (len(text_bytes) // 4) * 4
    for off in range(0, n, 4):
        word = struct.unpack_from("<I", text_bytes, off)[0]
        if (word & 0x9F000000) != 0x90000000:  # not ADRP
            continue
        if off + 8 > n:
            continue
        immlo = (word >> 29) & 0x3
        immhi = (word >> 5) & 0x7FFFF
        imm = (immhi << 2) | immlo
        if imm & (1 << 20):
            imm -= (1 << 21)
        pc = text_va + off
        page = (pc & ~0xFFF) + (imm << 12)
        if page != target_page:
            continue
        nxt = struct.unpack_from("<I", text_bytes, off + 4)[0]
        if (nxt & 0x7F800000) in (0x11000000, 0x91000000):
            imm12 = (nxt >> 10) & 0xFFF
            shift = (nxt >> 22) & 0x3
            resolved = page + (imm12 << (12 if shift == 1 else 0))
            if resolved == target_va:
                hits.append(pc)
    return hits


def scan_code_referencing(text_bytes, text_va, target_va):
    """Find every code VA whose ADRP(+ADD) pair resolves to ``target_va``.

    This is the cheap replacement for disassembling every vtable slot's body: a reference to a
    ``.rodata`` string on AArch64 is an ADRP page load followed by an ADD of the low 12 bits.
    Scanning the instruction stream once and matching the resolved page against the target's page
    finds every reference without a disassembler.

    Uses the vectorised path when numpy is present and an equivalent pure-Python one otherwise, so a
    missing numpy never degrades to a false "no references".
    """
    if len(text_bytes) < 8:
        return []
    if _np is None:
        return _scan_code_referencing_python(text_bytes, text_va, target_va)
    words = _np.frombuffer(text_bytes[: (len(text_bytes) // 4) * 4], dtype=_np.uint32)
    # ADRP: bit31 set, bits 28..24 = 0b10000 -> (w & 0x9F000000) == 0x90000000
    is_adrp = (words & _np.uint32(0x9F000000)) == _np.uint32(0x90000000)
    idxs = _np.nonzero(is_adrp)[0]
    if idxs.size == 0:
        return []
    target_page = target_va & ~0xFFF
    target_lo = target_va & 0xFFF
    hits = []
    adrp_words = words[idxs]
    immlo = ((adrp_words >> 29) & 0x3).astype(_np.int64)
    immhi = ((adrp_words >> 5) & 0x7FFFF).astype(_np.int64)
    imm = (immhi << 2) | immlo
    sign = _np.where(imm & (1 << 20), imm - (1 << 21), imm)
    pc = text_va + idxs.astype(_np.int64) * 4
    page = (pc & ~0xFFF) + (sign << 12)
    page_match = _np.nonzero(page == target_page)[0]
    for j in page_match:
        wi = int(idxs[j])
        if wi + 1 >= words.size:
            continue
        nxt = int(words[wi + 1])
        # ADD (immediate): 64-bit 0x91000000, 32-bit 0x11000000; SF bit picks the form.
        if (nxt & 0x7F800000) in (0x11000000, 0x91000000):
            imm12 = (nxt >> 10) & 0xFFF
            shift = (nxt >> 22) & 0x3
            resolved = int(page[j]) + (imm12 << (12 if shift == 1 else 0))
            if resolved == target_va:
                hits.append(int(pc[j]))
    return hits


def _prologue_contains_diagnostic(elf, fn_va, window=0x8000, refs=None):
    """Does the function at ``fn_va`` reference the render diagnostic within ``window`` bytes?"""
    if refs is None:
        return None
    return any(fn_va <= r < fn_va + window for r in refs)


class Elf:
    """Minimal read-only arm64 ELF reader: sections, symbol names, relocations, disassembly."""

    def __init__(self, path):
        self.path = path
        self._f = open(path, "rb")
        self.mm = mmap.mmap(self._f.fileno(), 0, access=mmap.ACCESS_READ)
        hdr = self.mm[:64]
        if hdr[:4] != b"\x7fELF":
            raise ValueError("not an ELF file")
        if hdr[4] != 2:
            raise ValueError("only 64-bit ELF is supported (arm64-v8a)")
        if struct.unpack_from("<H", hdr, 18)[0] != 0xB7:
            raise ValueError("only AArch64 is supported")
        self.sections = self._read_sections()
        self.by_name = {s["name"]: s for s in self.sections}
        self.relocs = self._read_relocations()
        self.addend_to_offset = {}
        self.offset_to_addend = {}
        for r_offset, _, addend in self.relocs:
            if addend and addend > 0:
                self.addend_to_offset.setdefault(addend, []).append(r_offset)
                self.offset_to_addend.setdefault(r_offset, addend)
        self.dynsym_names = {}       # VA -> symbol name (only the few defined ones)
        self._read_dynsym()

    # -- sections ---------------------------------------------------------
    def _read_sections(self):
        mm = self.mm
        e_shoff = struct.unpack_from("<Q", mm, 40)[0]
        e_shentsize = struct.unpack_from("<H", mm, 58)[0]
        e_shnum = struct.unpack_from("<H", mm, 60)[0]
        e_shstrndx = struct.unpack_from("<H", mm, 62)[0]
        raw = []
        for i in range(e_shnum):
            off = e_shoff + i * e_shentsize
            name, typ, flags, addr, offset, size, link, info, align, entsize = \
                struct.unpack_from("<IIQQQQIIQQ", mm, off)
            raw.append(dict(name_off=name, type=typ, flags=flags, addr=addr, offset=offset,
                            size=size, link=link, entsize=entsize))
        shstr = raw[e_shstrndx]
        for s in raw:
            n = shstr["offset"] + s["name_off"]
            s["name"] = mm[n:mm.find(b"\0", n)].decode(errors="replace")
        return raw

    # -- relocations ------------------------------------------------------
    def _read_relocations(self):
        out = []
        for sec in self.sections:
            if sec["type"] != 4:  # SHT_RELA
                continue
            entsize = sec["entsize"] or 24
            count = sec["size"] // entsize
            base = sec["offset"]
            for i in range(count):
                r_offset, r_info, r_addend = struct.unpack_from("<QQq", self.mm, base + i * entsize)
                r_type = r_info & 0xFFFFFFFF
                if r_type in (R_AARCH64_RELATIVE, R_AARCH64_ABS64):
                    out.append((r_offset, r_type, r_addend))
        return out

    def _read_dynsym(self):
        dynsym = self.by_name.get(".dynsym")
        dynstr = self.by_name.get(".dynstr")
        if not dynsym or not dynstr:
            return
        count = dynsym["size"] // 24
        for i in range(count):
            off = dynsym["offset"] + i * 24
            st_name, st_info, st_other, st_shndx, st_value, st_size = \
                struct.unpack_from("<IBBHQQ", self.mm, off)
            if st_value == 0 or st_name == 0:
                continue
            n = dynstr["offset"] + st_name
            name = self.mm[n:self.mm.find(b"\0", n)].decode(errors="replace")
            self.dynsym_names[st_value] = name

    # -- helpers ----------------------------------------------------------
    def section_text(self, name):
        s = self.by_name.get(name)
        if not s:
            return b""
        return self.mm[s["offset"]:s["offset"] + s["size"]]

    def find_in_section(self, name, needle):
        s = self.by_name.get(name)
        if not s:
            return []
        out = []
        start, end = s["offset"], s["offset"] + s["size"]
        idx = self.mm.find(needle, start, end)
        while idx != -1:
            out.append(idx)
            idx = self.mm.find(needle, idx + 1, end)
        return out

    def cstring(self, va):
        idx = va  # file offset == VA for the sections we read (PROGBITS, p_offset == p_vaddr)
        end = self.mm.find(b"\0", idx)
        return self.mm[idx:end].decode(errors="replace")

    def sha256(self):
        h = hashlib.sha256()
        self.mm.seek(0)
        while True:
            block = self.mm.read(8 * 1024 * 1024)
            if not block:
                break
            h.update(block)
        return h.hexdigest()

    # -- RTTI/vtable ------------------------------------------------------
    def typeinfo_name_va(self, mangled_name):
        """The VA of the length-prefixed typeinfo-name string (e.g. ``18LivePlayerRenderer``)."""
        needle = mangled_name if isinstance(mangled_name, bytes) else mangled_name.encode()
        hits = self.find_in_section(".rodata", needle)
        return hits[0] if hits else None

    def typeinfo_va(self, simple_name):
        n = len(simple_name)
        mangled = ("%d%s" % (n, simple_name)).encode()
        name_va = self.typeinfo_name_va(mangled)
        if name_va is None:
            return None, None
        refs = self.addend_to_offset.get(name_va, [])
        if not refs:
            return name_va, None
        # __class_type_info layout: vptr(8), __name(8) -> the relocation points at __name, so the
        # typeinfo starts 8 bytes earlier.
        return name_va, refs[0] - 8

    def vtable_address_point(self, typeinfo_va):
        refs = self.addend_to_offset.get(typeinfo_va, [])
        if not refs:
            return None
        # A vtable begins with offset-to-top(8) + typeinfo ptr(8); the address point (slot 0) is
        # 8 bytes after the typeinfo ptr's slot, i.e. at (vtable-8) + 16.
        return refs[0] + 8

    def vtable_slots(self, address_point, limit=400):
        """Return [(index, target_va_or_None)] for the vtable at ``address_point``."""
        slots = []
        for i in range(limit):
            a = address_point + i * POINTER_SIZE
            add = self.offset_to_addend.get(a)
            slots.append((i, add))
        return slots

    # -- disassembly ------------------------------------------------------
    def disassemble(self, start, stop=None, max_lines=40):
        """Disassemble [start, stop) with llvm-objdump if available, else raw words.

        Returns a list of text lines. The address is the VA as it appears in the binary.
        """
        if stop is None:
            stop = start + 0x100
        objdump = _find_objdump()
        if objdump:
            cmd = [objdump, "-d", "--start-address=0x%x" % start,
                   "--stop-address=0x%x" % stop, self.path]
            try:
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
                lines = [ln for ln in out.stdout.splitlines()
                         if ":" in ln and ln.strip().startswith(("9", "8", "a", "b", "c", "d", "e",
                                                                "0", "1", "2", "3", "4", "5", "6", "7", "f"))]
                return lines[:max_lines]
            except Exception:
                pass
        # Fallback: print the raw instruction words so the offsets are still inspectable.
        s = self.by_name.get(".text")
        lines = []
        if s and s["addr"] <= start < s["addr"] + s["size"]:
            off = s["offset"] + (start - s["addr"])
            for i in range(min(max_lines, (stop - start) // 4)):
                word = struct.unpack_from("<I", self.mm, off + i * 4)[0]
                lines.append("  %x: %08x" % (start + i * 4, word))
        return lines


def _find_objdump():
    candidates = [
        os.environ.get("LLVM_OBJDUMP"),
        "llvm-objdump",
    ]
    # NDK toolchain, if present.
    ndk_root = os.environ.get("ANDROID_NDK_HOME") or os.environ.get("ANDROID_NDK_ROOT")
    if ndk_root:
        import glob
        for p in glob.glob(os.path.join(ndk_root, "toolchains/llvm/prebuilt/*/bin/llvm-objdump")):
            candidates.insert(0, p)
    for c in candidates:
        if c and (os.path.sep not in c or os.path.exists(c)):
            try:
                subprocess.run([c, "--version"], capture_output=True, timeout=10)
                return c
            except Exception:
                continue
    return None


def _prologue_contains_diagnostic(elf, fn_va, window=0x4000):
    """Heuristic: does the function starting at ``fn_va`` reference the render diagnostic?

    The reference is an ADRP+ADD (or ADRP+LDR) pair loading ``variable.player_x_rotation``. We
    disassemble a window and look for the string's page in an ADRP, then an ADD of the low bits.
    Falls back to "true" when disassembly is unavailable and the slot is the only candidate.
    """
    diag_va = elf.typeinfo_name_va(RENDER_DIAGNOSTIC)
    if diag_va is None:
        return None
    lines = elf.disassemble(fn_va, fn_va + window, max_lines=window // 4)
    page = diag_va & ~0xFFF
    lo = diag_va & 0xFFF
    saw_adrp = False
    for ln in lines:
        low = ln.lower()
        if "adrp" in low:
            # Look for the page value (objdump prints the resolved absolute address, e.g. #0x2971000)
            if "%x" % page in low or "%X" % page in low:
                saw_adrp = True
        elif saw_adrp and ("add" in low) and ("%x" % lo in low or "%X" % lo in low or "#0x%x" % lo in low):
            return True
    return None


def analyze(path, version_override=None, rules_path=None):
    elf = Elf(path)
    result = {
        "path": path,
        "version": version_override or "unverified",
        "sha256": elf.sha256(),
        "size": os.path.getsize(path),
        "findings": {},
        "derived_rules": {},
    }
    f = result["findings"]

    # --- 1. LivePlayerRenderer ---
    name_va, ti_va = elf.typeinfo_va("LivePlayerRenderer")
    lpr = {"typeinfo_name_va": _h(name_va), "typeinfo_va": _h(ti_va)}
    if ti_va is not None:
        ap = elf.vtable_address_point(ti_va)
        lpr["vtable_address_point"] = _h(ap)
        slots = elf.vtable_slots(ap) if ap else []
        text_sec = elf.by_name.get(".text")
        diag_va = elf.typeinfo_name_va(RENDER_DIAGNOSTIC)
        refs = []
        if text_sec and diag_va is not None:
            refs = scan_code_referencing(elf.section_text(".text"), text_sec["addr"], diag_va)
        lpr["code_refs_to_render_diagnostic"] = len(refs)
        # Attribute each reference to the vtable-slot function whose [start, next start) interval (or
        # a bounded function size, whichever is smaller) contains it, then take the LOWEST slot
        # index with a hit — the same "first slot whose body references the string" rule the
        # launcher's resolver uses. The size cap matters: some references sit far past the last
        # vtable-slot function, and an unbounded tail window would misattribute them.
        max_fn = 0x40000
        starts = sorted((target, idx) for idx, target in slots if target)
        candidates = []
        for k, (fn_va, idx) in enumerate(starts):
            end = fn_va + max_fn
            if k + 1 < len(starts):
                end = min(end, starts[k + 1][0])
            count = sum(1 for r in refs if fn_va <= r < end)
            if count:
                candidates.append((idx, count, fn_va))
        if candidates:
            slot, count, fn = min(candidates, key=lambda c: c[0])
            lpr["render_vtable_index"] = slot
            lpr["render_reference_count"] = count
            lpr["render_function_va"] = _h(fn)
            lpr["render_prologue"] = elf.disassemble(fn, fn + 0x40, max_lines=16)
            result["derived_rules"]["playerRenderVtableIndex"] = slot
            # Item 17: the rule carries its own probe for the seam it pins, and the probe is the
            # same check the launcher makes at runtime — the slot resolves to a function inside
            # .text (executable code), not to a data pointer. A generated rule whose probe reports
            # false is refused by the native gate rather than trusted on the strength of the index
            # alone.
            in_text = False
            text_sec = elf.by_name.get(".text")
            if text_sec is not None:
                in_text = text_sec["addr"] <= fn < text_sec["addr"] + text_sec["size"]
            result["derived_rules"]["probes"] = {
                "playerRenderVtableIndex": {
                    "resolved": bool(in_text),
                    "proves": "the slot's target lies in .text (executable code)",
                }
            }
        else:
            lpr["render_vtable_index"] = None
            lpr["note"] = ("no vtable slot body referenced the render diagnostic; "
                           "the slot cannot be derived on this build from this anchor alone")
    f["live_player_renderer"] = lpr

    # --- 2. ClientInstance slot 31 (local player) ---
    _, ci_ti = elf.typeinfo_va("ClientInstance")
    ci = {"typeinfo_va": _h(ci_ti)}
    if ci_ti is not None:
        ap = elf.vtable_address_point(ci_ti)
        slots = dict(elf.vtable_slots(ap)) if ap else {}
        ci["vtable_address_point"] = _h(ap)
        ci["slot_31"] = _h(slots.get(31))
        ci["note"] = "slot 31 is the launcher's local-player accessor (verified by code reading)"
    f["client_instance"] = ci

    # --- 3. SerializedSkinRef accessors (cape/base image offsets) ---
    skin = {"accessor_names_present": {}}
    for name in ("getImageData", "getCapeImageData", "getCapeImageDataCereal",
                 "getAnimatedImageData", "getGeometryData", "getAnimationData",
                 "getCapeId", "getSkinColor", "getProfileHash", "SerializedSkinRef"):
        hits = elf.find_in_section(".rodata", name.encode())
        skin["accessor_names_present"][name] = len(hits)
    # Item 2: the persona half of the skin. Whether the persona piece fields are recoverable is a
    # per-build question, so report the accessor/type names a build actually carries rather than
    # assuming a layout. A build with zero persona names is reported as such - the launcher then
    # cannot claim a persona reading it cannot make.
    persona_names = ("PersonaPiece", "PersonaPieceTintColor", "getPersonaPieces",
                     "getPersonaSkinPieceId", "getPieceType", "getPieceId",
                     "getPersonaCapePiece", "PersonaSkinPiece")
    skin["persona_names_present"] = {
        name: len(elf.find_in_section(".rodata", name.encode())) for name in persona_names
    }
    skin["persona_layout_recoverable"] = any(skin["persona_names_present"].values())
    f["serialized_skin_ref"] = skin

    # --- 4. mce::Image loader signature ---
    loader = {"name_present": len(elf.find_in_section(".rodata", b"loadImageFromMemory"))}
    configured = _load_configured_pattern(rules_path)
    if configured:
        loader["configured_pattern_matches"] = _count_pattern(elf, configured)
    f["image_loader"] = loader

    # --- 5. ClientNetworkHandler AddPlayerPacket ---
    adder = {"name_present": len(elf.find_in_section(".rodata", b"AddPlayerPacket"))}
    f["network_handler"] = adder

    # --- 6. Render-distance option anchor (item 10) ---
    # Actually changing the game's render distance needs the options setter, which is not exported.
    # The route the item describes is a string anchor: find the option's own name in .rodata, then
    # the code that references it. Report whether the anchor string exists at all and how many code
    # sites reference it, so the launcher can say the route is possible for this build rather than
    # guessing a setter address.
    rd_names = ("render_distance", "renderDistance", "RenderDistance", "graphics_settings",
                "view_distance", "options.txt")
    rd = {name: len(elf.find_in_section(".rodata", name.encode())) for name in rd_names}
    rd["anchor_present"] = any(rd.values())
    rd["code_refs"] = 0
    anchor_va = elf.typeinfo_name_va("render_distance")
    text_sec = elf.by_name.get(".text")
    if anchor_va is not None and text_sec is not None:
        rd["code_refs"] = len(
            scan_code_referencing(elf.section_text(".text"), text_sec["addr"], anchor_va)
        )
    f["render_distance_option"] = rd

    # --- derived rules entry ---
    result["derived_rules"]["checksum_sha256"] = result["sha256"]
    result["derived_rules"]["min"] = result["version"]
    return result


def _h(value):
    return "0x%x" % value if isinstance(value, int) else None


def _count_pattern(elf, pattern):
    """Count the matches of a '? ?' wildcard pattern (bytes or ?? are wildcards)."""
    tokens = pattern.split()
    if not tokens:
        return 0
    first_fixed = next((i for i, t in enumerate(tokens) if t not in ("?", "??")), None)
    if first_fixed is None:
        return 0
    length = len(tokens)
    text = elf.section_text(".text")
    if not text:
        return 0
    anchor = bytes([int(tokens[first_fixed], 16)])
    matches = 0
    start = 0
    while True:
        idx = text.find(anchor, start)
        if idx == -1:
            break
        base = idx - first_fixed
        start = idx + 1
        if base < 0 or base + length > len(text):
            continue
        ok = True
        for j, t in enumerate(tokens):
            if t in ("?", "??"):
                continue
            if text[base + j] != int(t, 16):
                ok = False
                break
        if ok:
            matches += 1
    return matches


def _load_configured_pattern(rules_path):
    if not rules_path or not os.path.exists(rules_path):
        return None
    try:
        with open(rules_path) as fh:
            data = json.load(fh)
    except Exception:
        return None
    for rule in data.get("rules", []):
        sigs = rule.get("sigs", rule)
        if sigs.get("imageLoaderSig"):
            return sigs["imageLoaderSig"]
    return None


def print_human(result):
    print("Library: %s" % result["path"])
    print("Version: %s" % result["version"])
    print("Size:    %d bytes" % result["size"])
    print("SHA-256: %s" % result["sha256"])
    print()
    f = result["findings"]
    lpr = f["live_player_renderer"]
    print("1. LivePlayerRenderer (RTTI/vtable)")
    print("   typeinfo name string: %s" % lpr.get("typeinfo_name_va"))
    print("   typeinfo:             %s" % lpr.get("typeinfo_va"))
    print("   vtable address point: %s" % lpr.get("vtable_address_point"))
    print("   slot referencing the render diagnostic: %s"
          % lpr.get("slots_referencing_render_diagnostic"))
    print("   render vtable index:  %s" % lpr.get("render_vtable_index"))
    print("   render function VA:   %s" % lpr.get("render_function_va"))
    if lpr.get("render_prologue"):
        print("   prologue:")
        for ln in lpr["render_prologue"][:12]:
            print("     %s" % ln.strip())
    if lpr.get("note"):
        print("   NOTE: %s" % lpr["note"])
    print()
    ci = f["client_instance"]
    print("2. ClientInstance (local player)")
    print("   typeinfo:             %s" % ci.get("typeinfo_va"))
    print("   vtable address point: %s" % ci.get("vtable_address_point"))
    print("   slot 31 (local player):%s" % ci.get("slot_31"))
    print()
    skin = f["serialized_skin_ref"]
    print("3. SerializedSkinRef accessor name strings (present / expected)")
    for k, v in skin["accessor_names_present"].items():
        print("   %-28s %s" % (k, "present" if v else "ABSENT"))
    print("   (an absent accessor-name table means the +0xa8 cape offset must be re-derived "
          "by another anchor)")
    print()
    loader = f["image_loader"]
    print("4. mce::Image loader")
    print("   loadImageFromMemory string present: %s" % loader.get("name_present"))
    if "configured_pattern_matches" in loader:
        print("   configured imageLoaderSig matches:  %s" % loader["configured_pattern_matches"])
    print()
    print("5. ClientNetworkHandler AddPlayerPacket string present: %s"
          % f["network_handler"]["name_present"])
    print()
    print("Derived rules entry:")
    print(json.dumps(result["derived_rules"], indent=2))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("library", help="path to lib/arm64-v8a/libminecraftpe.so")
    parser.add_argument("--version", help="override the version label for the rules entry")
    parser.add_argument("--rules", help="path to the bundled preloader signature rules JSON")
    parser.add_argument("--json", action="store_true", help="emit the summary as JSON")
    args = parser.parse_args(argv)

    if not os.path.exists(args.library):
        print("no such file: %s" % args.library, file=sys.stderr)
        return 2
    try:
        result = analyze(args.library, args.version, args.rules)
    except ValueError as exc:
        print("cannot parse library: %s" % exc, file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print_human(result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
