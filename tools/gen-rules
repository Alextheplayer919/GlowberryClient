#!/usr/bin/env python3
"""gen-rules — derive a preloader signature-rules entry for a Minecraft Bedrock build in one step.

The launcher's native hooks resolve game functions by RTTI name and by per-version byte
signature. Both are version-fragile, so every new Bedrock build needs a fresh rules entry. Doing
that by hand (fetch the APK, find the ``.so``, run the analyzer, transcribe the numbers, hand-edit
the JSON, bump the revision) is where a rule gets a typo that only shows up as a hook that never
installs.

This script is that whole sequence, and nothing else:

    1. obtain the ``lib/arm64-v8a/libminecraftpe.so`` — from a local APK, or by downloading the
       APK from a URL you supply;
    2. run ``tools/verify-binary`` on it (the analyzer that reads the real library);
    3. merge the derived entry into the bundled rules JSON, bumping the revision.

It does NOT invent a value the analyzer could not derive, and it refuses to merge an entry with no
derived content — a rule that turns nothing on is worse than no rule, because it looks like the
build is covered.

Usage
-----
    tools/gen-rules --version 1.26.60.30 --apk-url https://.../minecraft-26-60-30.apk
    tools/gen-rules --version 1.26.60.30 --apk /path/to/minecraft.apk
    tools/gen-rules --version 1.26.60.30 --so /path/to/libminecraftpe.so
    tools/gen-rules ... --dry-run          # print the entry, do not write the JSON

The analyzer needs numpy and, for a fresh loader pattern, llvm-objdump. Both are in the dev
toolchain; a missing one is reported rather than silently skipping a step.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
VERIFY_BINARY = os.path.join(HERE, "verify-binary")
DEFAULT_RULES = os.path.join(REPO, "resources", "preloader",
                             "preloader_signature_rules_source.json")

# The one path inside a Bedrock APK that carries the game's native code.
NATIVE_LIB_PATH = "lib/arm64-v8a/libminecraftpe.so"

# A version label is four dotted numbers at most (1.26.60.30) or three (1.26.51).
VERSION_RE = re.compile(r"^\d+(\.\d+){1,3}$")


def version_key(version):
    """A sortable key for a dotted version, missing components read as zero.

    The rules file is kept in ascending order, and a plain string sort puts ``1.26.50.00`` before
    ``1.26.40.20``; comparing component-wise is what keeps the list in the order the launcher's
    own matcher expects.
    """
    parts = [int(p) for p in str(version).split(".") if p != ""]
    return tuple(parts + [0] * (4 - len(parts)))[:4]


def merge_rule(doc, entry):
    """Insert or replace a rules entry, keeping the list sorted and bumping the revision.

    A rule is identified by its ``min`` and ``max`` pair. Re-generating the same build replaces the
    existing entry rather than appending a duplicate, so running this twice is idempotent — a
    duplicate entry with a stale signature is how a rule silently wins over a fresh one.

    Pure: takes and returns plain data, so it is host-tested with no file system.
    """
    rules = list(doc.get("rules") or [])
    key = (entry.get("min"), entry.get("max"))
    kept = [r for r in rules if (r.get("min"), r.get("max")) != key]
    kept.append(entry)
    kept.sort(key=lambda r: (version_key(r.get("min") or "0"), version_key(r.get("max") or "0")))
    out = dict(doc)
    out["rules"] = kept
    out["revision"] = int(doc.get("revision") or 0) + 1
    return out


def has_derived_content(entry):
    """Whether an entry carries anything a hook can use.

    An entry with only a checksum turns no feature on, so merging it would make the build look
    covered while every hook stays off. That is the failure this guard exists to prevent.
    """
    if not entry:
        return False
    if entry.get("playerRenderVtableIndex") is not None:
        return True
    sigs = entry.get("sigs") or {}
    return any(v for v in sigs.values())


def probes_all_resolved(entry):
    """Whether every probe the entry carries reports success.

    Item 17: a generated rule must pass its own probe before it turns a feature on. A rule that
    declares a slot but carries a probe that failed would be refused by the native gate anyway; it
    is better to refuse to merge it, because a rule that is present but inert is indistinguishable
    from a working one in the rules file. An entry with no probes block (a hand-derived rule) is not
    affected.
    """
    probes = entry.get("probes") if entry else None
    if not probes:
        return True
    for name, probe in probes.items():
        if isinstance(probe, dict) and probe.get("resolved") is False:
            return False
    return True


def extract_native_lib(apk_path, dest_dir):
    """Extract ``lib/arm64-v8a/libminecraftpe.so`` from an APK into ``dest_dir``.

    A Bedrock APK is a zip; the native code is one stored-or-deflated entry. The file is large
    (hundreds of megabytes extracted), so the caller owns the destination and is expected to use a
    temporary directory.
    """
    with zipfile.ZipFile(apk_path) as zf:
        names = set(zf.namelist())
        if NATIVE_LIB_PATH not in names:
            # Some packages split the ABI; report what is there rather than a bare failure.
            candidates = sorted(n for n in names
                                if n.startswith("lib/") and n.endswith("libminecraftpe.so"))
            raise ValueError("APK has no %s; native libs present: %s"
                             % (NATIVE_LIB_PATH, candidates or "none"))
        out = os.path.join(dest_dir, "libminecraftpe.so")
        with zf.open(NATIVE_LIB_PATH) as src, open(out, "wb") as dst:
            shutil.copyfileobj(src, dst)
        return out


def download(url, dest_path):
    """Download a URL to a file, streaming so a several-hundred-megabyte APK is not held in memory."""
    import urllib.request
    with urllib.request.urlopen(url) as resp, open(dest_path, "wb") as dst:
        shutil.copyfileobj(resp, dst)
    return dest_path


def run_analyzer(so_path, version, rules_path):
    """Run ``tools/verify-binary --json`` and return the parsed result.

    The analyzer is executed as a subprocess rather than imported so a numpy or disassembler
    problem surfaces as its own exit code instead of an exception mid-merge.
    """
    cmd = [sys.executable, VERIFY_BINARY, so_path, "--version", version, "--json"]
    if rules_path and os.path.exists(rules_path):
        cmd += ["--rules", rules_path]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError("verify-binary failed (%d): %s" % (proc.returncode, proc.stderr.strip()))
    return json.loads(proc.stdout)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", required=True, help="the build's version label, e.g. 1.26.60.30")
    src = parser.add_mutually_exclusive_group(required=True)
    src.add_argument("--apk", help="a local Bedrock APK")
    src.add_argument("--apk-url", help="a URL to a Bedrock APK")
    src.add_argument("--so", help="an already-extracted libminecraftpe.so")
    parser.add_argument("--rules", default=DEFAULT_RULES, help="the rules JSON to merge into")
    parser.add_argument("--dry-run", action="store_true", help="print the entry, write nothing")
    args = parser.parse_args(argv)

    if not VERSION_RE.match(args.version):
        print("not a version label: %s" % args.version, file=sys.stderr)
        return 2

    tmp = tempfile.mkdtemp(prefix="gen-rules-")
    try:
        if args.so:
            so_path = args.so
        else:
            apk_path = args.apk
            if args.apk_url:
                apk_path = os.path.join(tmp, "package.apk")
                print("downloading %s" % args.apk_url)
                download(args.apk_url, apk_path)
            print("extracting %s" % NATIVE_LIB_PATH)
            so_path = extract_native_lib(apk_path, tmp)

        print("analyzing %s" % so_path)
        result = run_analyzer(so_path, args.version, args.rules)
        entry = dict(result.get("derived_rules") or {})
        entry["min"] = args.version
        entry.setdefault("max", args.version)

        if not has_derived_content(entry):
            print("the analyzer derived nothing usable for %s; refusing to merge an entry that "
                  "would turn no feature on" % args.version, file=sys.stderr)
            print(json.dumps(entry, indent=2))
            return 3

        if not probes_all_resolved(entry):
            print("the derived entry carries a probe that did not resolve for %s; refusing to merge "
                  "a rule whose own check failed (the native gate would refuse it too)"
                  % args.version, file=sys.stderr)
            print(json.dumps(entry, indent=2))
            return 4

        print("derived entry:")
        print(json.dumps(entry, indent=2))

        if args.dry_run:
            print("--dry-run: not writing %s" % args.rules)
            return 0

        with open(args.rules) as fh:
            doc = json.load(fh)
        merged = merge_rule(doc, entry)
        with open(args.rules, "w") as fh:
            json.dump(merged, fh, indent=2)
            fh.write("\n")
        print("wrote %s (revision %d, %d rules)"
              % (args.rules, merged["revision"], len(merged["rules"])))
        return 0
    except (ValueError, RuntimeError, OSError, zipfile.BadZipFile) as exc:
        print("gen-rules: %s" % exc, file=sys.stderr)
        return 2
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
