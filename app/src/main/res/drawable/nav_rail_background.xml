<?xml version="1.0" encoding="utf-8"?>
<!--
    The rail's surface plus the hairline that separates it from the content (U5).

    The hairline is part of the background rather than a child View: in a vertical LinearLayout a
    child with match_parent height would stretch to the full rail and a trailing 1dp child would
    not sit on the edge. A layer-list pins it to the end edge, which is what a divider is.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_bg_surface" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:gravity="end">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_stroke_hairline" />
        </shape>
    </item>
</layer-list>
