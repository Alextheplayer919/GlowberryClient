<?xml version="1.0" encoding="utf-8"?>
<!--
    One touch Mod Menu module card.

    Restyled to the VIP menu's visual language so the two screens read as one app: a darker card,
    an icon tile, name + caption, a pin, a real sliding switch and the configure gear. The switch is
    the click target for the state change; the card body still toggles for convenience. The card is
    deliberately darker than the VIP card (the touch menu sits over the game, where a lifted surface
    reads as fog) — the palette is UiTokens either way.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mod_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/ui_bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/mod_card_accent"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#00000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/mod_card_icon_tile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_vip_icon_tile">

                <ImageView
                    android:id="@+id/mod_card_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_modules"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mod_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mod_card_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/mod_unavailable_message"
                    android:textColor="@color/ui_danger"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mod_card_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_vip_icon_button"
                android:contentDescription="@string/mod_menu_favorite"
                android:defaultFocusHighlightEnabled="false"
                android:padding="8dp"
                android:src="@drawable/ic_star"
                android:tint="@color/ui_text_secondary" />

            <org.chimeramc.client.ui.components.UiSwitchView
                android:id="@+id/mod_card_switch"
                android:layout_width="36dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/mod_status_disabled" />

            <ImageButton
                android:id="@+id/mod_card_config"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_vip_icon_button"
                android:contentDescription="@string/vip_configure"
                android:defaultFocusHighlightEnabled="false"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/ui_text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
