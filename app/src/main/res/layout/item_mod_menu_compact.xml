<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="3dp"
    android:defaultFocusHighlightEnabled="false"
    app:cardBackgroundColor="@color/ui_bg_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/mod_card_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/mod_card_icon"
                android:layout_width="26dp"
                android:layout_height="26dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mod_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mod_card_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_mod_unavailable"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/mod_unavailable_message"
                    android:textColor="@color/ui_danger"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <org.chimeramc.client.ui.components.UiSwitchView
                android:id="@+id/mod_card_switch"
                android:layout_width="36dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/mod_status_disabled" />

            <ImageButton
                android:id="@+id/mod_card_config"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:defaultFocusHighlightEnabled="false"
                android:padding="5dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/ui_text_secondary" />

            <ImageButton
                android:id="@+id/mod_card_favorite"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:defaultFocusHighlightEnabled="false"
                android:padding="5dp"
                android:src="@drawable/ic_star"
                android:tint="@color/ui_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>